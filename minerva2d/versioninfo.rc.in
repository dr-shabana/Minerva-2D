#if defined(__MINGW64__) || defined(__MINGW32__)
#include <afxres.h>
#include <winresrc.h>
#else
#include <winres.h>
#endif

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(65001)

// CMake defines:

#define MINERVA2D_VERSION_STRING "${MINERVA2D_VERSION_STRING}"

#define MINERVA2D_STABLE_VERSION_MAJOR ${MINERVA2D_STABLE_VERSION_MAJOR}
#define MINERVA2D_STABLE_VERSION_MINOR ${MINERVA2D_STABLE_VERSION_MINOR}
#define MINERVA2D_VERSION_RELEASE ${MINERVA2D_VERSION_RELEASE}
#define MINERVA2D_VERSION_REVISION ${MINERVA2D_VERSION_REVISION}

#cmakedefine MINERVA2D_GIT_SHA1_STRING
#ifdef MINERVA2D_GIT_SHA1_STRING
#undef MINERVA2D_GIT_SHA1_STRING
#define MINERVA2D_GIT_SHA1_STRING "${MINERVA2D_GIT_SHA1_STRING}"
#endif

// ---

#ifdef MINERVA2D_GIT_SHA1_STRING
#define MINERVA2D_FULL_VERSION_STRING MINERVA2D_VERSION_STRING " (git " MINERVA2D_GIT_SHA1_STRING ")"
#else
#define MINERVA2D_FULL_VERSION_STRING MINERVA2D_VERSION_STRING
#endif

//#define MINERVA2D_IS_DLL
//#define MINERVA2D_IS_DEBUG
#define MINERVA2D_FILE_VERSION MINERVA2D_STABLE_VERSION_MAJOR,MINERVA2D_STABLE_VERSION_MINOR,MINERVA2D_VERSION_RELEASE,MINERVA2D_VERSION_REVISION
#define MINERVA2D_FILE_VERSION_STR MINERVA2D_FULL_VERSION_STRING
#define MINERVA2D_PRODUCT_VERSION MINERVA2D_FILE_VERSION
#define MINERVA2D_PRODUCT_VERSION_STR MINERVA2D_FILE_VERSION_STR

#define MINERVA2D_DESCRIPTION_STR "Minerva digital painting application"
#define MINERVA2D_FOUNDATION_STR "Minerva Foundation"


VS_VERSION_INFO VERSIONINFO
FILEVERSION MINERVA2D_FILE_VERSION
PRODUCTVERSION MINERVA2D_PRODUCT_VERSION
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef MINERVA2D_IS_DEBUG
FILEFLAGS VERMINERVA2D_IS_DEBUG
#else
FILEFLAGS 0x0L
#endif
FILEOS VOS__WINDOWS32
#ifdef MINERVA2D_IS_DLL
FILETYPE VFT_DLL
#else
FILETYPE VFT_APP
#endif
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName", MINERVA2D_FOUNDATION_STR
            VALUE "FileDescription", MINERVA2D_DESCRIPTION_STR
            VALUE "FileVersion", MINERVA2D_FILE_VERSION_STR
            VALUE "InternalName", "krita"
            VALUE "LegalCopyright", MINERVA2D_FOUNDATION_STR
            VALUE "OriginalFilename", "minerva2d.exe"
            VALUE "ProductName", "Minerva"
            VALUE "ProductVersion", MINERVA2D_PRODUCT_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1252
    END
END
